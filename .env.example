# ─────────────────────────────────────────────
#  TalentMind AI  ─  Environment Configuration
#  Copy this file to .env and fill values
# ─────────────────────────────────────────────

# ── Application ──────────────────────────────
APP_NAME=TalentMind AI
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=your-secret-key-min-32-chars-here

# ── Google Gemini API ─────────────────────────
GOOGLE_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.3

# ── Database ──────────────────────────────────
DATABASE_URL=sqlite:///./data/talentmind.db
DATABASE_ECHO=false

# ── File Upload ───────────────────────────────
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,docx,txt
UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed

# ── Reports ───────────────────────────────────
REPORTS_DIR=data/reports
VECTOR_DB_DIR=data/vector_db

# ── Logging ───────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/talentmind.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ── Security ──────────────────────────────────
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:8501